# 复制为 .env(本地开发)或 /opt/demo-app/env/runtime.env(服务器)。
# 真实文件永远不进 git。密码用 `openssl rand -hex 16` 生成。
POSTGRES_PASSWORD=change-me

# ---- 应用运行时配置(服务器上归 root:app,0640)----
# DATABASE_URL=postgres://demo_app:PASSWORD@127.0.0.1:5432/demo_app
# APP_ENV=production
# STORAGE_DIR=/srv/demo-app/storage
# PORT=3000
# WORKER_POLL_MS=1000
